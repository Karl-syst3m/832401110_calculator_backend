# Dependencies
node_modules/

# Runtime data (SQLite database files, not committed)
#
# Note the leading slash — it anchors the rule to the repository root.
# If it were written as `data/` (without the slash), git would match a directory
# named data at **any level**, so the source directory src/data/ would be excluded
# along with it, and src/data/units.js would never be committed at all.
#
# This trap really did happen: local tests were all green (the file did exist locally),
# and the failure only showed up after deploying to the server:
#   Error [ERR_MODULE_NOT_FOUND]: Cannot find module '.../src/data/units.js'
# While troubleshooting we went around in a circle because "it works fine locally",
# until
#   git check-ignore -v src/data/units.js
# pinpointed that this one rule was the cause.
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Environment variables
.env
.env.local

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
