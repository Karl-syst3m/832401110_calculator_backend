# =============================================================================
# systemd service unit — Calculator Backend
#
# Installation path: /etc/systemd/system/calculator-backend.service
#
# ★ Prefer installing with the script rather than copying this file by hand:
#       sudo ./deploy/install-backend.sh --dry-run   # first see what will happen
#       sudo ./deploy/install-backend.sh             # install for real
#
#   Reason: the <APP_DIR> and <NODE_BIN> placeholders in this file must be
#   replaced with absolute paths. In practice we found that if even one of them is
#   left unreplaced (for example <APP_DIR>), systemd refuses to start outright:
#
#       WorkingDirectory= path is not absolute: <APP_DIR>
#       Unit configuration has fatal error, unit will not be started.
#
#   And it does **not** tell you "you forgot to replace a placeholder", so while
#   troubleshooting it is very easy to misdiagnose this as a problem with the
#   service itself. install-backend.sh derives the paths from its own location and
#   substitutes them automatically, then runs `systemd-analyze verify` once more,
#   eliminating this failure mode at the root.
#
# If you really must install by hand, replace the placeholders and always verify
# before enabling:
#       sudo cp deploy/calculator-backend.service /etc/systemd/system/
#       sudo systemd-analyze verify /etc/systemd/system/calculator-backend.service
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now calculator-backend
#
# Viewing the logs:
#       sudo journalctl -u calculator-backend -f
# =============================================================================

[Unit]
Description=Calculator Backend (Express + SQLite)
After=network-online.target
Wants=network-online.target

# ---- Restart rate limiting ----
# Note: StartLimitIntervalSec / StartLimitBurst belong to the [Unit] section, not [Service].
# After systemd 229 they were moved from [Service] to [Unit].
# If they are mistakenly written under [Service], systemd merely logs one warning and ignores them:
#     Unknown key 'StartLimitIntervalSec' in section [Service], ignoring.
# The result is that restart rate limiting silently stops working — the service restarts
# over and over without ever stopping and raising an alarm.
# Configuration errors of this kind — "no error, just ignored" — are the hardest to find,
# which is why the section ownership is spelled out explicitly here.
# Meaning: more than 10 restarts within 5 minutes is treated as a fault that cannot heal
# itself, and further attempts stop.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

# ---- Run identity ----
# Use a dedicated low-privilege user rather than root.
# How to create it: sudo useradd --system --shell /usr/sbin/nologin --home /opt/calculator calculator
User=calculator
Group=calculator
WorkingDirectory=<APP_DIR>

# ---- Start command ----
# Start directly with node rather than through npm: one less process wrapper, and signals
# reach the Node process directly. This matters for graceful shutdown
# (npm intercepts SIGTERM, so the backend never receives it).
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=HOST=127.0.0.1
Environment=DB_FILE=<APP_DIR>/data/calculator.sqlite
Environment=LOG_LEVEL=info
ExecStart=<NODE_BIN> src/server.js

# ---- Automatic restart ----
Restart=always
RestartSec=3
# (The restart rate limits StartLimit* have been moved up to the [Unit] section; see the
# explanation there.)

# ---- Memory limits ----
# Measured, this backend's resident memory is about 20MB at rest and up to about
# 44MB after a burst of large base conversions (BigInt-heavy), so a 192MB ceiling
# leaves roughly a 4x margin. Under normal conditions it will never be approached,
# and should a memory leak appear, systemd restarts the process instead of dragging
# the entire machine down (this matters especially on servers shared with other services).
MemoryHigh=160M
MemoryMax=192M
# Explicitly forbid swap, so that under memory pressure the backend is not paged out and
# made slow to respond
MemorySwapMax=0

# ---- Resource limits ----
LimitNOFILE=65535
TasksMax=128

# ---- Security hardening ----
# A private /tmp, preventing interference with other services through temporary files
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Only the data directory may be written
ReadWritePaths=<APP_DIR>/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true

# Note: MemoryDenyWriteExecute is **deliberately not enabled** here.
#
# On the surface it suits a Node service ("the backend does not need executable memory
# pages"), but in practice it stops Node from starting at all: the V8 engine's JIT needs
# memory pages that are simultaneously writable and executable, and this option forbids
# creating them.
#
# Measured evidence (systemd 252 + Node 24.15.0):
#   MemoryDenyWriteExecute=yes  -> process exit code 255, with no output at all
#   without that option         -> exit code 0, node:sqlite and the HTTP service both work
#   (control experiment: node -e "process.exit(7)" returns 7, proving exit codes really are propagated)
#
# The danger is that systemd reports only a generic service start failure and never points
# out that this option caused it.
# The remaining sandbox options have been measured to be compatible with this service and
# can safely be kept.
# If the runtime is ever switched to a non-JIT one, enabling it can be reconsidered.

# Only allow IPv4/IPv6 TCP and Unix sockets
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ---- Logging ----
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calculator-backend

[Install]
WantedBy=multi-user.target
