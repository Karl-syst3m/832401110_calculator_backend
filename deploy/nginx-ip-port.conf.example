# =============================================================================
# nginx configuration example — no-domain scenario (accessed by public IP + port)
#
# Applies when:
#   - no domain name is available and access can only be by public IP
#   - ports 80 / 443 on the server are already taken by other sites (leave them alone)
#
# Approach: have nginx listen on an additional high port (8000 in this example) and let it
#           serve both the frontend static files and the /api reverse proxy.
#           Frontend and API share an origin, so no CORS configuration is needed.
#
# Placeholders to replace before deployment:
#   <FRONTEND_ROOT>   frontend static file directory, for example /var/www/calculator
#
# Suggested install location: /etc/nginx/sites-available/calculator
# Enable: sudo ln -s /etc/nginx/sites-available/calculator /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
#
# Besides the nginx configuration, the firewall and the security group rules for this port
# must also be opened; see the checklist in the "Deployment Without a Domain Name" section
# of deploy/DEPLOY.md.
#
# About HTTPS: Let's Encrypt does not issue certificates for a bare IP, so this approach can
# only use HTTP. This project transmits no credentials at all (calculation expressions and
# history records are not sensitive), so HTTP is acceptable; but the assignment blog should
# state this honestly.
# =============================================================================

upstream calculator_backend {
    # The backend listens only on the loopback address and is never exposed publicly; all traffic is forwarded by nginx
    server 127.0.0.1:5000;
    keepalive 16;
}

server {
    # Choose a high port that is not already in use.
    # Check whether it is free with `ss -ltn | grep :8000`.
    # 8080 / 8081 / 9000 are also common alternatives.
    listen 8000;
    listen [::]:8000;

    # When accessing by IP, the request's Host header is that IP or empty; `_` here means
    # "the default server on this port", so no specific domain has to be matched.
    server_name _;

    # ---- Basic security response headers ----
    # Note: over HTTP, HSTS is meaningless and harmful (it forces the browser to use HTTPS
    # from then on), so Strict-Transport-Security is deliberately not set here.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'" always;

    # ---- Compression ----
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- Frontend static files ----
    root <FRONTEND_ROOT>;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:html|js|css)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # ---- Reverse proxy for the backend API ----
    location /api/ {
        proxy_pass http://calculator_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    15s;
        proxy_read_timeout    15s;

        proxy_buffering off;
        add_header Cache-Control "no-store";
    }

    # ---- Health check, convenient for external liveness probing ----
    location = /healthz {
        proxy_pass http://calculator_backend/api/health;
        access_log off;
    }

    # ---- Deny access to hidden files and to source/data files ----
    # README.md and codestyle.md belong in the repository but should not appear in the web
    # directory; this rule is the second line of defense.
    location ~ /\. {
        deny all;
        return 404;
    }
    location ~* \.(?:md|sqlite|sqlite-wal|sqlite-shm|log|bak|env|json\.example)$ {
        deny all;
        return 404;
    }
}
