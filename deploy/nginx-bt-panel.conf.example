# =============================================================================
# nginx server block — for BT Panel environments
#
# ★ Where it goes: /www/server/panel/vhost/nginx/calculator.conf
#
# Why not /etc/nginx/sites-available/ ?
# On this machine nginx is managed by BT Panel and was compiled with the prefix
# /www/server/nginx (`nginx -V` shows --prefix=/www/server/nginx).
# The actual situation is:
#   - /etc/nginx/nginx.conf          does not exist
#   - /etc/nginx/sites-available/    does not exist
#   - /etc/nginx/sites-enabled/      does not exist (it is empty)
#   - under /etc/nginx/ there are only ssl/ and htpasswd_dsh (used by the panel's own services)
# So following the Debian convention of putting the configuration into sites-available and
# symlinking it into sites-enabled has **no effect at all** on this machine.
#
# The path that really takes effect is the end of /www/server/nginx/conf/nginx.conf:
#     include /www/server/panel/vhost/nginx/*.conf;
# so this file is loaded simply by placing it in that directory.
# The panel does not overwrite .conf files put there by hand (it only rewrites the site
# files it created itself).
#
# ---------------------------------------------------------------------------
# Port choice: 80
#
# Why not open 8000 in addition? Because measurements showed this machine's allow rules
# form a **two-layer whitelist**:
#   ufw        : allows only 22, 80, 443, 6185, 8443, 8889, 8899, 6100
#   cloud security group : measured reachable: 80 / 8443 / 6185 / 8899 / 6100,
#               443 reachable (answers RST because nothing listens),
#               888 / 8000 / 8080 / 3306 all dropped
# In other words, using 8000 would require both editing ufw and adding a security group
# rule in the cloud console, while 80 is already open at both layers and usable with zero
# changes.
#
# Why not write default_server ?
# Port 80 already hosts BT Panel's built-in status service (server_name 127.0.0.1, serving
# monitoring endpoints such as /nginx_status and /phpfpm_xx_status, which depend on default
# server behavior). Using our own IP as server_name gives an **exact match**, so there is no
# need — and no right — to seize default_server; both sides keep behaving as before.
#
# Placeholders that must be replaced before deployment:
#   <SERVER_IP>      the server's public IP, for example 103.236.57.2
#   <FRONTEND_ROOT>  frontend static file directory; on this machine /www/wwwroot/calculator is suggested
#
# How to enable:
#   sudo cp deploy/nginx-bt-panel.conf.example /www/server/panel/vhost/nginx/calculator.conf
#   sudo sed -i 's/<SERVER_IP>/your-IP/; s|<FRONTEND_ROOT>|/www/wwwroot/calculator|' \
#        /www/server/panel/vhost/nginx/calculator.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Rollback (just delete the file and reload):
#   sudo rm /www/server/panel/vhost/nginx/calculator.conf
#   sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

upstream calculator_backend {
    # The backend listens only on the loopback address and is never exposed publicly; all traffic is forwarded by nginx
    server 127.0.0.1:5000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;

    # Using the public IP as server_name: when http://<IP>/ is requested the Host header is
    # that IP, so this server block is matched exactly, while panel monitoring requests whose
    # Host is 127.0.0.1 are still handled by BT Panel's block.
    server_name <SERVER_IP>;

    # ---- Basic security response headers ----
    # Strict-Transport-Security (HSTS) is deliberately not set:
    # this site runs over plain HTTP, and setting HSTS would make the browser remember that
    # "this site is HTTPS-only from now on"; since the IP has no certificate, the result
    # would be locking visitors out.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'" always;

    # ─────────────────────────────────────────────────────────────────────────
    # ★ nginx's add_header does NOT inherit into a location that declares its own.
    #
    # This is a trap worth spelling out, because it cost us a real outage of the
    # security headers. On a plain `location / { }` with no add_header of its own,
    # nginx inherits the four headers above from the server block. But the moment a
    # location declares ANY add_header, the server-level set is discarded **entirely**
    # for that location — the two sets are not merged.
    #
    # Measured before the fix (curl -D - against the deployed site):
    #   /                 -> only "Cache-Control: no-cache, must-revalidate"
    #   /css/style.css    -> only "Cache-Control: no-cache, must-revalidate"
    #   /api/health       -> only "Cache-Control: no-store"
    # and NOT ONE of the four security headers was present on any of them —
    # including Content-Security-Policy, which matters most on the HTML response.
    # So the block above looked correct in review and was dead in production.
    #
    # nginx 1.26 does not have `add_header_inherit merge` (added in 1.29.3), so the
    # fix is to repeat the security headers inside every location that sets any
    # add_header of its own. The three locations below do that. If you add another
    # location with its own add_header, you must repeat them there too.
    # ─────────────────────────────────────────────────────────────────────────

    # ---- Compression ----
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- Frontend static files ----
    root <FRONTEND_ROOT>;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long cache for images and fonts; file names in this project carry no fingerprint, so
    # only this kind of resource gets a long cache
    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /www/server/panel/vhost/nginx/calculator-security-headers.conf;
        try_files $uri =404;
    }

    # HTML and JS/CSS are not cached, so an edit takes effect on the next refresh
    location ~* \.(?:html|js|css)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        include /www/server/panel/vhost/nginx/calculator-security-headers.conf;
        try_files $uri =404;
    }

    # ---- Reverse proxy for the backend API ----
    location /api/ {
        proxy_pass http://calculator_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    15s;
        proxy_read_timeout    15s;

        proxy_buffering off;
        add_header Cache-Control "no-store";
        include /www/server/panel/vhost/nginx/calculator-security-headers.conf;
    }

    # ---- Health check, convenient for external liveness probing ----
    location = /healthz {
        proxy_pass http://calculator_backend/api/health;
        access_log off;
    }

    # ---- Deny access to hidden files, source files, and data files ----
    # Keeping README.md / codestyle.md in the repository makes sense, but they should not
    # appear in the web directory; this rule is the second line of defense.
    location ~ /\. {
        deny all;
        return 404;
    }

    location ~* \.(?:md|sqlite|sqlite-wal|sqlite-shm|log|bak|env)$ {
        deny all;
        return 404;
    }
}
