# =============================================================================
# nginx 配置示例 —— 前后端分离计算器系统
#
# 用途：把前端静态文件与后端接口放在同一个源下，
#       前端用相对路径 /api 访问后端，浏览器不会发起跨域请求。
#
# 部署前必须替换的占位符：
#   <DOMAIN>          你的域名或子域名，例如 calc.example.com
#   <FRONTEND_ROOT>   前端静态文件目录，例如 /var/www/calculator
#   <CERT_PATH>       HTTPS 证书目录（若启用 HTTPS）
#
# 注意：本示例使用 80 端口。若服务器上 80 端口已被其他站点占用
# （可用 `ss -ltn | grep :80` 确认），请改用子域名方案：
# 新建本文件的 server 块，server_name 填子域名即可，nginx 会按域名分流，
# 不会与已有的默认站点冲突。
# =============================================================================

# ---------- 上游：后端服务 ----------
upstream calculator_backend {
    # 后端只监听回环地址，不直接暴露公网，所有流量经 nginx 转发
    server 127.0.0.1:5000;
    keepalive 16;
}

# ---------- HTTP：重定向到 HTTPS ----------
# 若暂未配置证书，可整段删除，并让下方 443 的配置用 80 端口。
server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN>;

    # 保留 ACME 校验路径，便于用 certbot 签发证书
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS：主站 ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <DOMAIN>;

    # ---- 证书 ----
    ssl_certificate     <CERT_PATH>/fullchain.pem;
    ssl_certificate_key <CERT_PATH>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---- 安全响应头 ----
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # 本项目前端不使用内联脚本与内联样式（主题变量走 CSS 文件），
    # 因此可以采用较严格的 CSP。若后续引入内联脚本需相应放宽。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'" always;

    # ---- 压缩 ----
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- 前端静态文件 ----
    root <FRONTEND_ROOT>;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 带指纹的静态资源可长期缓存；本项目文件名不含指纹，故只对图片与字体长缓存。
    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # HTML 与 JS/CSS 不缓存，保证改完刷新即可生效
    location ~* \.(?:html|js|css)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # ---- 后端接口反向代理 ----
    location /api/ {
        proxy_pass http://calculator_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # 后端开了 trust proxy，靠这两个头拿到真实客户端 IP
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    15s;
        proxy_read_timeout    15s;

        # 接口响应不应被缓存
        proxy_buffering off;
        add_header Cache-Control "no-store";
    }

    # ---- 健康检查（可直接被外部探活） ----
    location = /healthz {
        proxy_pass http://calculator_backend/api/health;
        access_log off;
    }

    # ---- 隐藏文件与备份文件 ----
    location ~ /\. {
        deny all;
        return 404;
    }
    location ~* \.(?:md|sqlite|sqlite-wal|sqlite-shm|log|bak|env)$ {
        deny all;
        return 404;
    }
}
