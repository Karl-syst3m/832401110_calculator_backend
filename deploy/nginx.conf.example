# =============================================================================
# nginx configuration example — calculator system with separated frontend and backend
#
# Purpose: serve the frontend static files and the backend API under the same origin, so
#          the frontend reaches the backend at the relative path /api and the browser
#          never issues a cross-origin request.
#
# Placeholders that must be replaced before deployment:
#   <DOMAIN>          your domain or subdomain, for example calc.example.com
#   <FRONTEND_ROOT>   frontend static file directory, for example /var/www/calculator
#   <CERT_PATH>       HTTPS certificate directory (if HTTPS is enabled)
#
# Note: this example uses port 80. If port 80 on the server is already taken by another
# site (check with `ss -ltn | grep :80`), switch to the subdomain approach instead:
# create a server block from this file and set server_name to the subdomain; nginx routes
# by domain name, so it will not conflict with the existing default site.
# =============================================================================

# ---------- Upstream: the backend service ----------
upstream calculator_backend {
    # The backend listens only on the loopback address and is never exposed publicly; all traffic is forwarded by nginx
    server 127.0.0.1:5000;
    keepalive 16;
}

# ---------- HTTP: redirect to HTTPS ----------
# If no certificate is configured yet, this whole block can be deleted and the 443
# configuration below moved to port 80.
server {
    listen 80;
    listen [::]:80;
    server_name <DOMAIN>;

    # Keep the ACME validation path so certificates can be issued with certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS: the main site ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <DOMAIN>;

    # ---- Certificates ----
    ssl_certificate     <CERT_PATH>/fullchain.pem;
    ssl_certificate_key <CERT_PATH>/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---- Security response headers ----
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # The frontend of this project uses neither inline scripts nor inline styles (theme
    # variables live in a CSS file), so a fairly strict CSP can be used. It will have to be
    # relaxed accordingly if inline scripts are introduced later.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'" always;

    # ---- Compression ----
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # ---- Frontend static files ----
    root <FRONTEND_ROOT>;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fingerprinted static assets could be cached long-term; file names in this project
    # carry no fingerprint, so only images and fonts get a long cache.
    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # HTML and JS/CSS are not cached, so an edit takes effect on the next refresh
    location ~* \.(?:html|js|css)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # ---- Reverse proxy for the backend API ----
    location /api/ {
        proxy_pass http://calculator_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # The backend enables trust proxy; these two headers provide the real client IP
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 5s;
        proxy_send_timeout    15s;
        proxy_read_timeout    15s;

        # API responses should not be cached
        proxy_buffering off;
        add_header Cache-Control "no-store";
    }

    # ---- Health check (can be probed from outside directly) ----
    location = /healthz {
        proxy_pass http://calculator_backend/api/health;
        access_log off;
    }

    # ---- Hidden files and backup files ----
    location ~ /\. {
        deny all;
        return 404;
    }
    location ~* \.(?:md|sqlite|sqlite-wal|sqlite-shm|log|bak|env)$ {
        deny all;
        return 404;
    }
}
